{
  "name": "@cyclonium/asset-pipeline",
  "version": "0.0.1",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrinktofit/cyclonium",
    "directory": "packages/cyclo-asset-pipeline"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "lib/**/*{.js,.d.ts}"
  ],
  "exports": {
    ".": "./lib/index.js"
  },
  "scripts": {
    "prepublishOnly": "pnpm exec tsc -b --clean && pnpm exec tsc -b",
