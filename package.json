{
  "name": "@cyclonium/home",
  "version": "0.0.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/shrinktofit/cyclonium"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "test": "turbo test",
    "clean:ours": "git clean -xdi --exclude=**/node_modules/",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "node --run build && changeset publish",
    "publish:extension-cyclo": "exm publish cc-extension-cyclo"
  },
  "lint-staged": {
    "*.{cjs,cts,js,jsx,mjs,mts,ts,tsx,vue}": "eslint --max-warnings=0"
  },
  "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@cyclonium/workflow": "workspace:*",
    "@shrinktofit/eslint-config": "^0.0.10",
    "eslint": "^9.39.5",
    "lint-staged": "^17.3.0",
    "turbo": "^2.9.12",
    "typescript": "6.0.2"
  }
}
